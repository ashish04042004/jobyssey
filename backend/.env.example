# Copy to .env for running the API/worker on your machine (outside Docker).

NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# Local: matches docker-compose.yml.
# Supabase: use the pooled connection string (port 6543, add ?pgbouncer=true&connection_limit=5)
DATABASE_URL=postgresql://jobyssey:jobyssey@localhost:5432/jobyssey?schema=public
# Supabase only: direct connection (port 5432) used by `prisma migrate`.
# DIRECT_DATABASE_URL=

# Local: matches docker-compose.yml. Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6380

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Refresh-token cookie. `lax` when the SPA and API share a site; `none` only for
# genuinely cross-site setups (requires COOKIE_SECURE=true). COOKIE_SECURE
# defaults to true when NODE_ENV=production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Run the background worker inside the API process (single free-tier instance).
RUN_WORKER_IN_API=false
