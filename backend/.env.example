# Copy to .env for running the API/worker on your machine (outside Docker).

NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# Local: matches docker-compose.yml.
# Supabase: the "Session pooler" connection string (IPv4, port 5432).
DATABASE_URL=postgresql://jobyssey:jobyssey@localhost:5432/jobyssey?schema=public
# Supabase: CA bundle the app verifies the database certificate against.
# DATABASE_SSL_CA=certs/supabase-prod-ca-2021.crt
# Optional: a different URL for `prisma migrate` (defaults to DATABASE_URL).
# Supabase: the same URL + ?sslmode=require (Prisma's migrate engine ignores DATABASE_SSL_CA).
# DIRECT_DATABASE_URL=
# Connections shared by the API and the in-process worker.
DATABASE_POOL_MAX=10

# Local: matches docker-compose.yml. Render Key Value: its internal connection string.
REDIS_URL=redis://localhost:6380

# Production only: shared with the Cloudflare Pages /api proxy (at least 32 chars).
# PROXY_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Refresh-token cookie. `lax` when the SPA and API share a site; `none` only for
# genuinely cross-site setups (requires COOKIE_SECURE=true). COOKIE_SECURE
# defaults to true when NODE_ENV=production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Run the background worker inside the API process (single free-tier instance).
RUN_WORKER_IN_API=false

# Document storage. `local` stores files under STORAGE_LOCAL_DIR behind signed,
# short-lived API URLs. `supabase` uploads directly to a private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=documents
